# ============================================================
# RENDER BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================================

# Django Secret Key (Generate a secure random string)
SECRET_KEY=django-insecure-prod-vasavi-temple-saas-secret-key-replace-with-random-50-chars

# Set to False in production
DEBUG=False

# Allowed Hosts (Render service URL + your custom domains)
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Frontend Vercel URL for CSRF & CORS headers
FRONTEND_URL=https://your-frontend-project.vercel.app

# ============================================================
# SUPABASE POSTGRESQL DATABASE CONNECTION
# ============================================================
# Option A: Full Connection String from Supabase (Recommended)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Session mode (Port 5432)" or "Transaction pooler (Port 6543)"
DATABASE_URL=postgresql://postgres.yourprojectref:YOUR_STRONG_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Option B: Individual Credentials (If not using DATABASE_URL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.yourprojectref
# DB_PASSWORD=YOUR_STRONG_PASSWORD
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
