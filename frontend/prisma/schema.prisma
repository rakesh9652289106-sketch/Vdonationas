// Prisma Schema for VD Multi-Temple Digital Donation & Temple Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  mobile           String?
  avatar           String?
  role             String       @default("DEVOTEE") // SUPER_ADMIN, TEMPLE_ADMIN, FINANCE_ADMIN, CONTENT_ADMIN, DEVOTEE
  isTwoFactorAuth  Boolean      @default(false)
  twoFactorSecret  String?
  status           String       @default("ACTIVE") // ACTIVE, SUSPENDED
  language         String       @default("en") // en, te, ta, hi
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userRoles        UserRole[]
  templeAdmins     TempleAdmin[]
  donations        Donation[]
  favoriteTemples  FavoriteTemple[]
  recurring        RecurringDonation[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]       @relation("AuditUser")
  donorProfile     DonorProfile?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  userRoles   UserRole[]
  rolePerms   RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. temple.view, donation.refund, qr.manage
  description String?
  rolePerms   RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Temple {
  id                 String             @id @default(uuid())
  code               String             @unique // e.g. TPL-001
  name               String
  deity              String
  description        String
  history            String?
  address            String
  city               String
  state              String
  pinCode            String
  country            String             @default("India")
  contactPhone       String
  contactEmail       String
  website            String?
  trustName          String
  registrationNo     String
  taxBenefitInfo     String?            // 80G information if eligible
  logoUrl            String?
  bannerUrl          String?
  timings            String?
  verificationStatus String             @default("VERIFIED") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED, SUSPENDED
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  templeAdmins       TempleAdmin[]
  gallery            TempleGallery[]
  categories         DonationCategory[]
  campaigns          Campaign[]
  festivals          Festival[]
  poojas             Pooja[]
  sevas              Seva[]
  qrCodes            QRCode[]
  donations          Donation[]
  announcements      Announcement[]
  favoriteTemples    FavoriteTemple[]
  offlineDonations   OfflineDonation[]
  recurringDonations RecurringDonation[]
}

model TempleAdmin {
  userId   String
  templeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@id([userId, templeId])
}

model TempleGallery {
  id        String   @id @default(uuid())
  templeId  String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model DonationCategory {
  id          String   @id @default(uuid())
  templeId    String
  name        String   // Annadanam, Daily Pooja, Temple Development, etc.
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  donations   Donation[]
  qrCodes     QRCode[]
}

model Campaign {
  id             String           @id @default(uuid())
  templeId       String
  title          String
  description    String
  story          String?
  bannerUrl      String?
  goalAmount     Float
  currentRaised  Float            @default(0)
  startDate      DateTime
  endDate        DateTime
  minDonation    Float            @default(10)
  status         String           @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  temple         Temple           @relation(fields: [templeId], references: [id], onDelete: Cascade)
  updates        CampaignUpdate[]
  donations      Donation[]
  qrCodes        QRCode[]
}

model CampaignUpdate {
  id          String   @id @default(uuid())
  campaignId  String
  title       String
  description String
  imageUrl    String?
  videoUrl    String?
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Festival {
  id          String   @id @default(uuid())
  templeId    String
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  isLive      Boolean  @default(true)
  createdAt   DateTime @default(now())

  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model Pooja {
  id          String   @id @default(uuid())
  templeId    String
  title       String
  description String
  price       Float
  timing      String
  isActive    Boolean  @default(true)
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Seva {
  id          String   @id @default(uuid())
  templeId    String
  title       String
  description String
  price       Float
  isActive    Boolean  @default(true)
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Booking {
  id          String   @id @default(uuid())
  bookingNo   String   @unique
  userId      String?
  poojaId     String?
  sevaId      String?
  devoteeName String
  date        DateTime
  timeSlot    String
  amount      Float
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())

  pooja       Pooja?   @relation(fields: [poojaId], references: [id])
  seva        Seva?    @relation(fields: [sevaId], references: [id])
}

model QRCode {
  id           String            @id @default(uuid())
  qrCodeId     String            @unique // e.g. QR-001
  templeId     String
  provider     String            @default("UPI_DIRECT")
  upiId        String
  displayName  String
  qrImageUrl   String
  categoryId   String?
  campaignId   String?
  status       String            @default("ACTIVE") // ACTIVE, INACTIVE, REPLACED
  isDefault    Boolean           @default(false)
  startDate    DateTime          @default(now())
  endDate      DateTime?
  createdAt    DateTime          @default(now())

  temple       Temple            @relation(fields: [templeId], references: [id], onDelete: Cascade)
  category     DonationCategory? @relation(fields: [categoryId], references: [id])
  campaign     Campaign?         @relation(fields: [campaignId], references: [id])
}

model Donation {
  id             String            @id @default(uuid())
  donationId     String            @unique // e.g. DON-20260822-9081
  userId         String?
  templeId       String
  categoryId     String?
  campaignId     String?
  amount         Float
  paymentMethod  String            // UPI, CARD, NETBANKING, QR, CASH
  transactionId  String            @unique
  status         String            @default("PENDING") // INITIATED, PENDING, SUCCESS, FAILED, CANCELLED, REFUNDED
  isAnonymous    Boolean           @default(false)
  isPublic       Boolean           @default(true)
  dedicationMsg  String?
  onBehalfOf     String?           // Family member dedication
  donorName      String
  donorEmail     String
  donorPhone     String
  donorPan       String?
  donorAddress   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User?             @relation(fields: [userId], references: [id])
  temple         Temple            @relation(fields: [templeId], references: [id])
  category       DonationCategory? @relation(fields: [categoryId], references: [id])
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  receipt        Receipt?
  refund         Refund?
  reconciliation Reconciliation?
}

model Receipt {
  id               String   @id @default(uuid())
  receiptNo        String   @unique // e.g. REC-2026-89102
  donationId       String   @unique
  verificationCode String   @unique // 8-character verification token
  pdfUrl           String?
  issuedAt         DateTime @default(now())

  donation         Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Refund {
  id          String   @id @default(uuid())
  donationId  String   @unique
  amount      Float
  reason      String
  requestedBy String
  approvedBy  String?
  status      String   @default("COMPLETED")
  refundRef   String   @unique
  createdAt   DateTime @default(now())

  donation    Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model OfflineDonation {
  id            String   @id @default(uuid())
  templeId      String
  donorName     String
  amount        Float
  paymentMethod String   // CASH, CHEQUE, BANK_TRANSFER
  referenceNo   String?
  date          DateTime @default(now())
  recordedBy    String
  notes         String?
  createdAt     DateTime @default(now())

  temple        Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model Reconciliation {
  id               String   @id @default(uuid())
  donationId       String   @unique
  gatewayAmount    Float
  actualSettlement Float
  difference       Float    @default(0)
  settlementId     String?
  status           String   @default("MATCHED") // MATCHED, PENDING, MISMATCH, REFUNDED
  reconciledAt     DateTime @default(now())

  donation         Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // DONATION, RECEIPT, FESTIVAL, SECURITY
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  templeId  String
  title     String
  content   String
  isAlert   Boolean  @default(false)
  createdAt DateTime @default(now())

  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model FavoriteTemple {
  userId   String
  templeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@id([userId, templeId])
}

model RecurringDonation {
  id         String   @id @default(uuid())
  userId     String
  templeId   String
  amount     Float
  interval   String   @default("MONTHLY") // WEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextDate   DateTime
  status     String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple     Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
}

model DonorProfile {
  userId        String   @id
  totalDonated  Float    @default(0)
  donationCount Int      @default(0)
  favoriteDeity String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  action    String   // e.g. CHANGED_QR_CODE, PROCESSED_REFUND
  templeId  String?
  details   String   // JSON string of changes
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation("AuditUser", fields: [userId], references: [id])
}

model SecurityLog {
  id        String   @id @default(uuid())
  eventType String   // FAILED_LOGIN, REPEATED_PAYMENT_FAILURE, QR_EDIT
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  details   String
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  ticketNo    String   @unique
  userId      String
  subject     String
  category    String   // PAYMENT_MISSING, RECEIPT_ISSUE, OTHER
  description String
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  key   String @id
  value String
}
